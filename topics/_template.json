      "display": "Example",
      "colorKey": "primary",
      "popupKey": "example-term"
    }
  },

  "slides": [
    {
      "id": "slide-1-1",
      "sectionIndex": 0,
      "title": "Welcome to Your Topic",
      "content": [
        {
          "type": "html",
          "content": "This is your first slide. Add content here."
        },
        {
          "type": "insight-box",
          "title": "Key Concept",
          "content": "Explain something important here. Use {term:example-term:clickable terms} to link to popups."
        }
      ]
    },
    {
      "id": "slide-1-2",
      "sectionIndex": 0,
      "title": "Second Slide",
      "content": [
        {
          "type": "table",
          "class": "uncertainty-table",
          "headers": ["Column 1", "Column 2", "Column 3"],
          "rows": [
            ["Row 1 Cell 1", "Row 1 Cell 2", "Row 1 Cell 3"],
            ["Row 2 Cell 1", "Row 2 Cell 2", "Row 2 Cell 3"]
          ]
        }
      ]
    },
    {
      "id": "slide-2-1",
      "sectionIndex": 1,
      "title": "Section 2 Content",
      "content": [
        {
          "type": "image",
          "src": "images/your-image.png",
          "alt": "Description of image"
        },
        {
          "type": "html",
          "content": "Content for section 2."
        }
      ]
    }
  ],

  "popups": {
    "example-term": {
      "title": "Example Term",
      "color": "#4f46e5",
