        {
          "type": "divider"
        },
        {
          "type": "scientific",
          "title": "",
          "content": "Formal definition here.",
          "formula": "Optional formula"
        },
        {
          "type": "example",
          "title": "Example",
          "content": "A concrete example of this concept."
        }
      ]
    }
  }
